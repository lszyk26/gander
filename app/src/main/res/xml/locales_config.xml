<?xml version="1.0" encoding="utf-8"?>
<!-- The languages the app ships strings for, so Android 13's per-app language picker
     (Settings > Apps > Gander > Language) lists them instead of only the system default.
     One entry per values-* directory that carries strings: English in values/, and
     Simplified Chinese in values-zh-rCN/. -->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="zh-CN" />
</locale-config>
